# Example only: install as a separate HTTPS virtual host after replacing placeholders.
# Existing EC2 app/Next.js configuration can remain on its own hostname/port.
# Certificate provisioning and public port access are environment-specific.
server {
    listen 443 ssl;
    server_name API_HOST;
    ssl_certificate /etc/letsencrypt/live/API_HOST/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/API_HOST/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 6m;
    client_body_timeout 15s;
    add_header X-Content-Type-Options nosniff always;
    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        # FastAPI's TrustedHostMiddleware remains restricted to loopback.
        proxy_set_header Host 127.0.0.1:8787;
        # Preserve Origin and X-Amiga-Proxy-Secret. FastAPI verifies both.
        # Do not replace Origin with localhost or accept a visitor's forwarded Host.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 100s;
        proxy_connect_timeout 5s;
    }
}
