# Copy locally; never paste a real key into chat or commit it.
# app/configure_local.py fills the three local values below on first run.
AMIGA_DATABASE_URL=
AMIGA_DB_PASSWORD=
AMIGA_DEMO_PASSWORD=

# Extraction: Bedrock reads first, OpenAI only when Bedrock fails.
AMIGA_EXTRACTION_PROVIDER=bedrock
AMIGA_EXTRACTION_FALLBACK=openai
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AMIGA_BEDROCK_MODEL_ID=global.amazon.nova-2-lite-v1:0
AMIGA_BEDROCK_STOP_USD=2.00

# OpenAI fallback and its spend ledger.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Enable live providers only after configuring your own credentials and spend limits.
AMIGA_LIVE_ENABLED=false
AMIGA_STOP_USD=8.00
AMIGA_MAX_OUTPUT_TOKENS=8192

# Robot Admin SOP (RAG). Without the embedding ID the tools default to Cohere, which rag.py refuses,
# so every question would silently fall back to word search. Titan V1 runs in us-east-1.
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v1
BEDROCK_MODEL_ID=apac.amazon.nova-lite-v1:0
# Parked Bedrock Knowledge Base path (knowledge-base/tools/kb.py); leave commented unless you revive it.
# AWS_REGION=ap-southeast-1
# AWS_BUCKET=
# BEDROCK_KB_ID=
# BEDROCK_KB_ROLE_ARN=

# Base of the verification link printed as a QR on signed vouchers.
AMIGA_PUBLIC_BASE_URL=http://127.0.0.1:8787
# Hybrid Vercel/EC2 only: same server-only secret as the Vercel frontend.
# Empty preserves local demo access. A configured secret protects all backend routes.
AMIGA_PROXY_SECRET=

# Hubungi klien: n8n webhook that sends the final voucher to the client's Telegram. Empty keeps sending off.
# https only, or http to a local n8n. The secret goes in the X-Amiga-Secret header (n8n Header Auth).
AMIGA_N8N_VOUCHER_WEBHOOK_URL=
AMIGA_N8N_WEBHOOK_SECRET=
# Telegram chat every client starts with as a recipient, for the demo. Empty adds none.
AMIGA_TELEGRAM_DEFAULT_CHAT_ID=
