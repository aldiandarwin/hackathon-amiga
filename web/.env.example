# Vercel server-only variables. Set these in Production before building.
# Use a dedicated HTTPS endpoint that proxies directly to FastAPI, not the EC2 Next app.
AMIGA_BACKEND_ORIGIN=https://api-amiga.example.com
AMIGA_PUBLIC_BASE_URL=https://amiga.example.com
# Generate privately and set the same value in the backend service environment.
AMIGA_PROXY_SECRET=
